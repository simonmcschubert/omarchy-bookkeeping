#!/usr/bin/env bash
# Installs Bookkeeping on Omarchy: a user service that runs the local server
# at login, a "Bookkeeping" web app in the app launcher with a browser
# profile of its own, and what invoices need (see install_invoice_tools).
# Running it again after a `git pull` restarts the server with the new code.
# `setup --remove` takes it out again; the data and receipts stay.
#
# `setup --backup [user@]host:path` copies the data and receipts to another
# computer every night: a user timer runs the `backup` script (see there).
# `setup --no-backup` stops that; the copies there stay.
# `setup --invoice-tools` installs only what invoices need (CI uses it).
set -euo pipefail

NAME=Bookkeeping
UNIT=omarchy-bookkeeping.service
PORT=47221
URL="http://127.0.0.1:$PORT/"
DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
UNIT_FILE="$UNIT_DIR/$UNIT"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-bookkeeping"
DATA_FILE="$STATE_DIR/bookkeeping.json"
# The nightly copy to another computer: where to (written by --backup, read
# by the backup script), its result (written by the script, read by the app),
# and the timer that runs it.
BACKUP_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-bookkeeping/backup.conf"
BACKUP_STATUS="$STATE_DIR/backup-status"
BACKUP_UNIT=omarchy-bookkeeping-backup
# The window's browser profile: no extensions, and nothing shared with
# everyday browsing.
PROFILE="$STATE_DIR/browser"
# Invoices: Chromium prints them, pikepdf (Python) makes the PDF a ZUGFeRD
# e-invoice and the Mustang validator (Java) checks each one. Chromium,
# Java and pikepdf come from pacman; Mustang is one file from Maven
# Central, checked against its SHA-256 before it is used.
MUSTANG_VERSION=2.26.0
MUSTANG_SHA256=42d7868cb68264874a7b8cab4c3587b03b23ccc7cd72373da917f66758bb9736
MUSTANG_URL="https://repo1.maven.org/maven2/org/mustangproject/Mustang-CLI/$MUSTANG_VERSION/Mustang-CLI-$MUSTANG_VERSION.jar"
MUSTANG_JAR="$DIR/tools/mustang-cli.jar"

fail() {
  echo "setup: $*" >&2
  exit 1
}

usage() {
  cat <<USAGE
Usage: setup                               install, or update after git pull
       setup --remove                      take the service and launcher entry out
       setup --backup [user@]host:path     copy the data and receipts there every night
       setup --no-backup                   stop the nightly copy
       setup --invoice-tools               install only what invoices need
USAGE
}

# The timer runs every hour, so a laptop that was offline tries again soon;
# the script copies once a day. Persistent: an hour missed while asleep or
# off runs at wake-up.
install_backup_units() {
  mkdir -p "$UNIT_DIR"
  cat >"$UNIT_DIR/$BACKUP_UNIT.service" <<UNIT_EOF
[Unit]
Description=Bookkeeping: copy the data and receipts to another computer ($DIR)

[Service]
Type=oneshot
ExecStart=$DIR/backup --daily
Nice=10
IOSchedulingClass=idle
UNIT_EOF
  cat >"$UNIT_DIR/$BACKUP_UNIT.timer" <<UNIT_EOF
[Unit]
Description=Bookkeeping: nightly copy of the data and receipts

[Timer]
OnCalendar=hourly
Persistent=true

[Install]
WantedBy=timers.target
UNIT_EOF
  systemctl --user daemon-reload
  systemctl --user enable --now "$BACKUP_UNIT.timer" >/dev/null
}

remove_backup() {
  systemctl --user disable --now "$BACKUP_UNIT.timer" 2>/dev/null || true
  # Also a copy running right now, or it would write its status afterwards.
  systemctl --user stop "$BACKUP_UNIT.service" 2>/dev/null || true
  rm -f "$UNIT_DIR/$BACKUP_UNIT.service" "$UNIT_DIR/$BACKUP_UNIT.timer" "$BACKUP_CONFIG" "$BACKUP_STATUS"
  systemctl --user daemon-reload
}

# Sets where the nightly copy goes, installs the timer and makes the first
# copy, as the timer would.
set_backup() {
  local dest=$1 old result message
  # A folder of its own: not a home directory (host:, host:~) or /.
  local on_host='^([^@:/[:space:]]+@)?[A-Za-z0-9._-]+:[^[:space:]]*[^[:space:]/.~]/?$'
  local here='^/[^[:space:]]*[^[:space:]/]/?$'
  [[ $dest =~ $on_host || $dest =~ $here ]] ||
    fail "give the destination as [user@]host:path or /path, such as user@server:backups/omarchy-bookkeeping"
  [[ $dest != *[\"\'\\%]* ]] || fail "the destination may not contain quotes, backslashes or %"
  command -v rsync >/dev/null || fail "rsync is missing. Install it once: sudo pacman -S rsync"

  mkdir -p "$(dirname "$BACKUP_CONFIG")" "$STATE_DIR"
  chmod 700 "$STATE_DIR"
  {
    echo "# Where Bookkeeping's nightly copy goes (setup --backup)."
    echo "destination=$dest"
    # The timer runs outside the login session: it gets this session's SSH
    # agent, which holds the key (such as ssh-tpm-agent's).
    if [[ -n ${SSH_AUTH_SOCK:-} ]]; then
      echo "ssh_auth_sock=$SSH_AUTH_SOCK"
    fi
  } >"$BACKUP_CONFIG"
  case ${SSH_AUTH_SOCK:-} in
    "" | "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/*) ;;
    *) echo "Note: the SSH agent at $SSH_AUTH_SOCK may move after the next login; then run setup --backup again." ;;
  esac

  # A new destination starts without a copy.
  old=$(sed -n 's/^destination=//p' "$BACKUP_STATUS" 2>/dev/null || true)
  if [[ $old != "$dest" ]]; then
    echo "destination=$dest" >"$BACKUP_STATUS"
  fi

  install_backup_units
  echo "Copying to $dest (the first time takes a while)..."
  systemctl --user start "$BACKUP_UNIT.service" || true
  result=$(sed -n 's/^result=//p' "$BACKUP_STATUS")
  message=$(sed -n 's/^message=//p' "$BACKUP_STATUS")
  case $result in
    ok)
      echo "Done: $message. From now on it copies once a day; Settings › Backup shows the last copy."
      ;;
    unreachable)
      echo "$message right now. The timer tries every hour; Settings › Backup shows when it worked."
      ;;
    *)
      journalctl --user -u "$BACKUP_UNIT.service" -n 5 --no-pager -o cat 2>/dev/null || true
      fail "the first copy failed: ${message:-see journalctl --user -u $BACKUP_UNIT.service}"
      ;;
  esac
}

TOOLS_ONLY=false
case ${1:-} in
  "") ;;
  --invoice-tools) TOOLS_ONLY=true ;;
  --remove)
    systemctl --user disable --now "$UNIT" 2>/dev/null || true
    rm -f "$UNIT_FILE"
    remove_backup
    if command -v omarchy-webapp-remove >/dev/null; then
      OMARCHY_REMOVE_NOTIFY=false omarchy-webapp-remove "$NAME" || true
    fi
    rm -rf "$PROFILE" "$DIR/tools"
    echo "Removed Bookkeeping's service, launcher entry, nightly copy and Mustang validator. The data and receipts stay in $STATE_DIR."
    exit 0
    ;;
  --backup)
    [[ -n ${2:-} ]] || fail "say where to: setup --backup [user@]host:path"
    [[ $DIR != *[[:space:]\"\\%]* ]] || fail "move the repository to a path without spaces, quotes, backslashes or %"
    set_backup "$2"
    exit 0
    ;;
  --no-backup)
    remove_backup
    echo "The nightly copy is off. The copies made so far stay where they are."
    exit 0
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    fail "unknown option: $1"
    ;;
esac

PYTHON=$(command -v python3) || fail "python3 not found"
"$PYTHON" -c 'import sys; sys.exit(sys.version_info < (3, 11))' || fail "Bookkeeping needs Python 3.11 or newer"

have_chromium() {
  local name
  for name in chromium chromium-browser google-chrome-stable google-chrome; do
    command -v "$name" >/dev/null && return 0
  done
  return 1
}

# The packages invoices need, from pacman: asks for sudo only when one is
# missing. The server's Python (the one this runs) must import pikepdf.
install_invoice_packages() {
  local missing=()
  have_chromium || missing+=(chromium)
  command -v java >/dev/null || missing+=(jre-openjdk-headless)
  "$PYTHON" -c 'import pikepdf' 2>/dev/null || missing+=(python-pikepdf)
  ((${#missing[@]})) || return 0
  if ! command -v pacman >/dev/null; then
    echo "setup: invoices need ${missing[*]}: install them, then run setup again." >&2
    return 1
  fi
  echo "Invoices need ${missing[*]}. Installing them with pacman (sudo):"
  sudo pacman -S --needed --noconfirm "${missing[@]}"
}

# Downloads the Mustang validator into tools/ (not in git), again only when
# its version changes.
fetch_mustang() {
  if [[ -f $MUSTANG_JAR ]] && sha256sum --status -c <<<"$MUSTANG_SHA256  $MUSTANG_JAR"; then
    return 0
  fi
  echo "Downloading the Mustang validator $MUSTANG_VERSION (about 60 MB)..."
  mkdir -p "${MUSTANG_JAR%/*}"
  curl -fsSL --retry 3 -o "$MUSTANG_JAR.part" "$MUSTANG_URL" || return 1
  if ! sha256sum --status -c <<<"$MUSTANG_SHA256  $MUSTANG_JAR.part"; then
    rm -f "$MUSTANG_JAR.part"
    echo "setup: the Mustang download does not match its checksum; not used" >&2
    return 1
  fi
  mv "$MUSTANG_JAR.part" "$MUSTANG_JAR"
}

install_invoice_tools() {
  install_invoice_packages && fetch_mustang
}

if $TOOLS_ONLY; then
  install_invoice_tools || fail "the invoice tools are not complete"
  echo "Invoice tools ready: Chromium, Java, pikepdf and $MUSTANG_JAR"
  exit 0
fi

command -v omarchy-webapp-install >/dev/null || fail "omarchy-webapp-install not found; is this Omarchy?"
[[ $DIR != *[[:space:]\"\\%]* ]] || fail "move the repository to a path without spaces, quotes, backslashes or %"
[[ $PROFILE != *[[:space:]\"\\%]* ]] || fail "Bookkeeping needs a state directory without spaces, quotes, backslashes or %: $STATE_DIR"

mkdir -p "$(dirname "$UNIT_FILE")"
cat >"$UNIT_FILE" <<UNIT_EOF
[Unit]
Description=Bookkeeping: local server for the bookkeeping app ($DIR)

[Service]
ExecStart=$PYTHON $DIR/server.py --port $PORT
Restart=on-failure

[Install]
WantedBy=default.target
UNIT_EOF

mkdir -p "$STATE_DIR"
chmod 700 "$STATE_DIR"

# Without these, all but invoice PDFs works; the Invoices view says what
# is missing.
install_invoice_tools || echo "setup: invoices can't be made into PDFs until this works: run setup again." >&2

systemctl --user daemon-reload
systemctl --user enable "$UNIT" >/dev/null
systemctl --user restart "$UNIT"

# After a git pull: the nightly copy's units with this checkout's paths.
if [[ -f $BACKUP_CONFIG ]]; then
  install_backup_units
fi

omarchy-webapp-install "$NAME" "$URL" "$DIR/icon.png" \
  "omarchy-launch-webapp $URL --user-data-dir=$PROFILE --no-first-run --no-default-browser-check"

for _ in $(seq 20); do
  if curl -fs -o /dev/null "$URL"; then
    echo "Bookkeeping runs on $URL"
    echo "App launcher (Super+Space): Bookkeeping. Data: $DATA_FILE"
    exit 0
  fi
  sleep 0.25
done
fail "the server did not start; see: journalctl --user -u $UNIT"
